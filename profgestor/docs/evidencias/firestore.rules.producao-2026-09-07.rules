rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function activeUser() {
      return signedIn() && exists(userPath()) && get(userPath()).data.ativo == true;
    }
    function role() { return activeUser() ? get(userPath()).data.role : null; }
    function isStaff() { return activeUser() && (role() == 'admin' || role() == 'professor'); }
    function linkedAlunoId() { return activeUser() ? get(userPath()).data.alunoId : null; }
    function isFamily() { return activeUser() && (role() == 'aluno' || role() == 'responsavel'); }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid && (
        (!exists(/databases/$(database)/documents/sistema/configuracao)
          && request.resource.data.role == 'admin' && request.resource.data.ativo == true)
        || familyProfileFromInvite()
      );
      allow update, delete: if isStaff();
    }

    function familyProfileFromInvite() {
      return request.auth.token.email != null
        && exists(/databases/$(database)/documents/convites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/convites/$(request.auth.token.email)).data.ativo == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ativo == true
        && request.resource.data.role == get(/databases/$(database)/documents/convites/$(request.auth.token.email)).data.role
        && request.resource.data.alunoId == get(/databases/$(database)/documents/convites/$(request.auth.token.email)).data.alunoId;
    }

    match /convites/{emailId} {
      allow read: if isStaff() || (signedIn() && request.auth.token.email == emailId);
      allow create, update, delete: if isStaff();
    }

    match /sistema/{docId} {
      allow read: if isStaff();
      allow create: if signedIn() && docId == 'configuracao'
        && !exists(/databases/$(database)/documents/sistema/configuracao)
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /alunos/{docId} {
      allow read: if isStaff() || (isFamily() && docId == linkedAlunoId());
      allow write: if isStaff();
    }
    match /aulas/{docId} {
      allow read: if isStaff() || (isFamily() && resource.data.alunoId == linkedAlunoId());
      allow write: if isStaff();
    }
    match /despesas/{docId} {
      allow read, write: if isStaff();
    }
    match /pacotes/{docId} {
      allow read: if isStaff() || (isFamily() && resource.data.alunoId == linkedAlunoId());
      allow write: if isStaff();
    }

    match /solicitacoes/{docId} {
      allow read: if isStaff() || (isFamily() && resource.data.alunoId == linkedAlunoId());
      allow create: if isFamily()
        && request.resource.data.alunoId == linkedAlunoId()
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.status == 'pendente';
      allow update, delete: if isStaff();
    }
    match /materiais/{docId} {
      allow read: if isStaff() || (isFamily() && resource.data.alunoId == linkedAlunoId() && resource.data.publicado == true);
      allow write: if isStaff();
    }


    match /organizations/{orgId} {
      allow read: if isStaff() && get(userPath()).data.organizationId == orgId;
      allow create, update: if isStaff() && get(userPath()).data.organizationId == orgId;
      allow delete: if false;
    }
    match /leads/{docId} {
      allow read: if isStaff() && resource.data.organizationId == get(userPath()).data.organizationId;
      allow create: if isStaff() && request.resource.data.organizationId == get(userPath()).data.organizationId;
      allow update: if isStaff() && resource.data.organizationId == get(userPath()).data.organizationId && request.resource.data.organizationId == get(userPath()).data.organizationId;
      allow delete: if isStaff() && resource.data.organizationId == get(userPath()).data.organizationId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
